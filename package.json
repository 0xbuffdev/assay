{
  "name": "@0xbuff/assay",
  "version": "0.0.1",
  "description": "Standalone deterministic technical evaluation of versioned criteria and bounded evidence",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xbuffdev/assay.git"
  },
  "bugs": {
    "url": "https://github.com/0xbuffdev/assay/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "check:foundation": "node scripts/check-foundation.mjs",
    "typecheck": "tsc --noEmit",
    "generate:version": "node scripts/version-metadata.mjs --write",
    "build": "node scripts/version-metadata.mjs && tsdown && node scripts/verify-dist.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check:style": "biome check .",
    "check": "pnpm check:foundation && pnpm typecheck && pnpm check:style && pnpm test && pnpm build && pnpm verify:package",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "COPYRIGHT.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "tsdown": "0.23.7",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
